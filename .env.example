# Copy to .env (gitignored) and fill in real values. Never commit real credentials.

# Database connection for the WordPress site(s) listed in config/scope.json.
# Use read-only DB credentials wherever the check allows it.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=wordpress
DB_USER=readonly_user
DB_PASSWORD=

# Optional: Slack/email webhook for report delivery.
REPORT_WEBHOOK_URL=

# Credentials for the two disposable test accounts the IDOR tester logs in
# as (scripts/run_idor_test.py). Create these on staging first — see
# src/security_toolkit/recon/provision.py and README.md. Never real users'
# credentials, and never committed — this file is the template only.
IDOR_USER_A_USERNAME=
IDOR_USER_A_PASSWORD=
IDOR_USER_B_USERNAME=
IDOR_USER_B_PASSWORD=
