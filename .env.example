# Copy to .env (gitignored) and fill in real values. Never commit real credentials.

# Database connection for the WordPress site(s) listed in config/scope.json.
# Use read-only DB credentials wherever the check allows it.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=wordpress
DB_USER=readonly_user
DB_PASSWORD=

# Optional: Slack/email webhook for report delivery.
REPORT_WEBHOOK_URL=

# MongoDB instance that stores test-account credentials (see
# src/security_toolkit/credentials_db.py), keyed by target name + label.
# This is the toolkit's OWN store — point it at your own local instance or
# your own private Atlas cluster, never a shared/production Mongo. Run
# `scripts/provision_test_accounts.py` or `scripts/manage_credentials.py add`
# to populate it; the IDOR/auth testers read from it directly, nothing to
# set here per-account.
#
# Local:  mongodb://localhost:27017
# Atlas:  mongodb+srv://<user>:<password>@<cluster-host>/?retryWrites=true&w=majority
#         (the password must be URL-encoded if it contains @, :, /, ?, #, etc.)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=security_toolkit

# Cloudinary account that every report uploads to (see
# src/security_toolkit/reporting/cloud_report.py) — nothing is written to
# local disk. Your own private account, never a shared/production one.
# Paste the single connection string from your Cloudinary dashboard's
# "API Environment variable" (Settings -> Access Keys), or fill in the
# three separate values below instead — either is fine, not both needed.
CLOUDINARY_URL=
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Legacy fallback only (superseded by the MongoDB store above): credentials
# for the two disposable test accounts, read if you hand-supply them via
# .env instead of provisioning/storing them in MongoDB.
IDOR_USER_A_USERNAME=
IDOR_USER_A_PASSWORD=
IDOR_USER_B_USERNAME=
IDOR_USER_B_PASSWORD=
